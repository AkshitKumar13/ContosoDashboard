@page "/document-reports"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Administrator")]
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Document Reports - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <h1>Document Reports</h1>
    <p class="text-muted">Document activity and usage retained for the last 12 months.</p>
    @if (report is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="row g-4">
            <div class="col-md-4"><div class="card"><div class="card-header">Document Types</div><ul class="list-group list-group-flush">@foreach (var item in report.Types) { <li class="list-group-item d-flex justify-content-between"><span>@item.ContentType</span><strong>@item.Count</strong></li> }</ul></div></div>
            <div class="col-md-4"><div class="card"><div class="card-header">Active Uploaders</div><ul class="list-group list-group-flush">@foreach (var item in report.Uploaders) { <li class="list-group-item d-flex justify-content-between"><span>@item.UploaderName</span><strong>@item.Count</strong></li> }</ul></div></div>
            <div class="col-md-4"><div class="card"><div class="card-header">Access Patterns</div><ul class="list-group list-group-flush">@foreach (var item in report.AccessPatterns) { <li class="list-group-item d-flex justify-content-between"><span>@item.Action</span><strong>@item.Count</strong></li> }</ul></div></div>
        </div>
    }
</div>

@code {
    private DocumentReport? report;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (int.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var userId))
            report = await DocumentService.GetAdminReportAsync(userId);
    }
}
